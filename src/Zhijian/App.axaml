<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Zhijian.App"
             Name="Zhijian"
             xmlns:markdownThemes="using:CodeWF.Avalonia.Markdown.Themes"
             xmlns:codewf="https://codewf.com" xmlns:semi="https://irihi.tech/semi"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <FontFamily x:Key="DefaultFontFamily">Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif</FontFamily>
    </Application.Resources>
    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN" />
        <semi:SemiPopupAnimations />
        <codewf:ACSemiTheme />
        <codewf:StudioTheme />
		<codewf:MindViewThemes/>
        <markdownThemes:MarkdownThemes/>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        </Style>
    </Application.Styles>
</Application>
