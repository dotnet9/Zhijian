<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Zhijian.App"
             Name="Zhijian"
             xmlns:markdownThemes="using:CodeWF.Avalonia.Markdown.Themes"
             xmlns:codewf="https://codewf.com" xmlns:semi="https://irihi.tech/semi"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN" />
        <semi:SemiPopupAnimations />
        <codewf:ACSemiTheme />
        <codewf:StudioTheme />
		<codewf:MindViewThemes/>
        <markdownThemes:MarkdownThemes/>
    </Application.Styles>
</Application>
