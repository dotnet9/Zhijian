<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Zhijian.App"
             Name="Zhijian"
             xmlns:markdownThemes="using:CodeWF.Markdown.Lite.Themes"
             xmlns:codewf="https://codewf.com"
             RequestedThemeVariant="Light">

    <Application.Styles>
		<codewf:MindViewThemes/>
        <markdownThemes:MarkdownThemes/>
    </Application.Styles>
</Application>
