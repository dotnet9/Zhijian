<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="using:AtomUI.Desktop.Controls"
             xmlns:codewf="https://codewf.com"
             xmlns:icons="using:AtomUI.Icons.AntDesign"
             xmlns:l="clr-namespace:Zhijian"
             xmlns:views="using:Zhijian.Views"
             xmlns:vm="using:Zhijian.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="360"
             d:DesignHeight="680"
             x:Class="Zhijian.Views.WorkspaceOutlineView"
             x:DataType="vm:WorkspaceOutlineViewModel">

    <Grid x:Name="OutlineEditorHost"
          RowDefinitions="*,Auto">
        <views:OutlineEditor x:Name="OutlineEditorControl"
                             Grid.Row="0"
                             IsVisible="{Binding IsOutlineMode}"
                             IsDarkTheme="{Binding IsDarkTheme}"
                             Roots="{Binding Roots}"
                             SelectedNode="{Binding SelectedNode, Mode=TwoWay}"
                             CenterTopicPlaceholder="{codewf:I18n {x:Static l:ZhijianL.CenterTopicPlaceholder}}"
                             TopicPlaceholder="{codewf:I18n {x:Static l:ZhijianL.TopicPlaceholder}}"
                             NotePlaceholder="{codewf:I18n {x:Static l:ZhijianL.NotePlaceholder}}"
                             AddChildText="{codewf:I18n {x:Static l:ZhijianL.AddChild}}"
                             AddSiblingText="{codewf:I18n {x:Static l:ZhijianL.AddSibling}}"
                             PromoteText="{codewf:I18n {x:Static l:ZhijianL.Promote}}"
                             DemoteText="{codewf:I18n {x:Static l:ZhijianL.Demote}}"
                             MoveUpText="{codewf:I18n {x:Static l:ZhijianL.MoveUp}}"
                             MoveDownText="{codewf:I18n {x:Static l:ZhijianL.MoveDown}}"
                             AddNoteText="{codewf:I18n {x:Static l:ZhijianL.AddNote}}"
                             EditNoteText="{codewf:I18n {x:Static l:ZhijianL.EditNote}}"
                             DeleteNodeText="{codewf:I18n {x:Static l:ZhijianL.DeleteNode}}"
                             DragNodeTip="{codewf:I18n {x:Static l:ZhijianL.DragNodeTip}}"
                             DropAsChildText="{codewf:I18n {x:Static l:ZhijianL.DropAsChildText}}"
                             DropBeforeText="{codewf:I18n {x:Static l:ZhijianL.DropBeforeText}}"
                             DropAfterText="{codewf:I18n {x:Static l:ZhijianL.DropAfterText}}"/>

        <atom:TextBox Grid.Row="0"
                      IsVisible="{Binding IsMarkdownMode}"
                      Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      FontFamily="Consolas, Menlo, monospace"
                      FontSize="14"
                      Margin="12,8,12,0"
                      Padding="10,8"
                      PlaceholderText="{codewf:I18n {x:Static l:ZhijianL.MarkdownPlaceholder}}"
                      Foreground="{Binding PrimaryTextBrush}"
                      Background="{Binding PanelBackground}"
                      BorderBrush="{Binding PanelBorderBrush}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.MarkdownPlaceholder}}"/>

        <Grid Grid.Row="1"
              Margin="8,4,8,6"
              ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding EditorPaneTitle}"
                       Foreground="{Binding SecondaryTextBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="3">
                <atom:Button Width="28"
                             Height="26"
                             Padding="6"
                             Command="{Binding AddChildToSelected}"
                             IsVisible="{Binding IsOutlineMode}"
                             AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.AddChild}}"
                             atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.AddChild}}">
                    <icons:SubnodeOutlined Width="14"
                                           Height="14"
                                           Foreground="{Binding SecondaryTextBrush}"/>
                </atom:Button>
                <atom:Button Width="28"
                             Height="26"
                             Padding="6"
                             Command="{Binding AddSiblingToSelected}"
                             IsEnabled="{Binding CanAddSiblingToSelectedNode}"
                             IsVisible="{Binding IsOutlineMode}"
                             AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.AddSibling}}"
                             atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.AddSibling}}">
                    <icons:SisternodeOutlined Width="14"
                                              Height="14"
                                              Foreground="{Binding SecondaryTextBrush}"/>
                </atom:Button>
                <atom:Button Width="28"
                             Height="26"
                             Padding="6"
                             IsVisible="{Binding IsOutlineMode}"
                             AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.OutlineShortcuts}}"
                             atom:ToolTip.Placement="Top">
                    <atom:ToolTip.Tip>
                        <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.OutlineShortcutsTip}}"
                                   TextAlignment="Left"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"/>
                    </atom:ToolTip.Tip>
                    <icons:QuestionCircleOutlined Width="14"
                                                  Height="14"
                                                  Foreground="{Binding SecondaryTextBrush}"/>
                </atom:Button>
                <Border Width="1"
                        Height="16"
                        Margin="3,0"
                        Background="{Binding PanelBorderBrush}"
                        IsVisible="{Binding IsOutlineMode}"/>
                <atom:Button Width="28"
                             Height="26"
                             Padding="6"
                             Command="{Binding CopyAsMarkdownAsync}"
                             AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.CopyAsMarkdown}}"
                             atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.CopyAsMarkdown}}">
                    <icons:CopyOutlined Width="14"
                                        Height="14"
                                        Foreground="{Binding SecondaryTextBrush}"/>
                </atom:Button>
                <atom:Button x:Name="EditorModeToggleButton"
                             Width="28"
                             Height="26"
                             Padding="6"
                             Command="{Binding ToggleEditorMode}"
                             AutomationProperties.Name="{Binding ToggleEditorToolTip}"
                             atom:ToolTip.Tip="{Binding ToggleEditorToolTip}">
                    <Grid Width="14" Height="14">
                        <icons:FileMarkdownOutlined Width="14"
                                                    Height="14"
                                                    Foreground="{Binding SecondaryTextBrush}"
                                                    IsVisible="{Binding IsOutlineMode}"/>
                        <icons:UnorderedListOutlined Width="14"
                                                    Height="14"
                                                    Foreground="{Binding SecondaryTextBrush}"
                                                    IsVisible="{Binding IsMarkdownMode}"/>
                    </Grid>
                </atom:Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
