<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:l="clr-namespace:Zhijian"
             xmlns:mind="https://codewf.com"
             xmlns:views="using:Zhijian.Views"
             xmlns:vm="using:Zhijian.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="820"
             x:Class="Zhijian.Views.MainWindow"
             WindowStartupLocation="CenterScreen"
             x:DataType="vm:MainWindowViewModel"
             Icon="/Assets/logo.ico"
             Width="1240"
             Height="820"
             MinWidth="980"
             MinHeight="640"
             Title="{Binding WindowTitle}"
             TitleBarBackground="{DynamicResource StudioBackground}" TitleBarHeight="40" CaptionButtonWidth="34">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <codewf:CodeWFWindow.Styles>
        <Style Selector="Border.panel">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 6 18 0 #10000000"/>
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TabControl.workspaceTabs /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
            <Setter Property="Spacing" Value="24"/>
        </Style>
        <Style Selector="TabControl.workspaceTabs TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource StudioMuted}"/>
        </Style>
        <Style Selector="Border.statusBar">
            <Setter Property="Background" Value="{DynamicResource StudioSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 4 14 0 #0F000000"/>
        </Style>
        <Style Selector="GridSplitter">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter>
        </Style>
    </codewf:CodeWFWindow.Styles>

    <Grid Background="{DynamicResource StudioBackground}">
        <Grid RowDefinitions="*,Auto">
            <Grid x:Name="PaneGrid" Grid.Row="0" Margin="16,16,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="280" MaxWidth="560"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="OutlinePaneHost"
                        Grid.Column="0"
                        Classes="panel"
                        IsVisible="{Binding IsWorkspacePaneVisible}"
                        Background="{DynamicResource StudioSurface}"
                        BorderBrush="{DynamicResource StudioBorder}">
                    <TabControl Classes="workspaceTabs"
                                     SelectedIndex="{Binding WorkspaceTabIndex, Mode=TwoWay}">
                        <TabItem x:Name="FilesTabItem"
                                       Header="{codewf:I18n {x:Static l:ZhijianL.FilesTab}}">
                            <views:WorkspaceFilesView DataContext="{Binding FilesPane}"/>
                        </TabItem>

                        <TabItem x:Name="OutlineTabItem"
                                       Header="{codewf:I18n {x:Static l:ZhijianL.OutlineTab}}">
                            <views:WorkspaceOutlineView x:Name="WorkspaceOutlineView"
                                                        DataContext="{Binding OutlinePane}"/>
                        </TabItem>
                    </TabControl>
                </Border>

                <Grid x:Name="PaneSplitterVisual"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      IsVisible="{Binding IsWorkspacePaneVisible}"
                      IsHitTestVisible="False">
                    <Border Width="1"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource StudioBorder}"/>
                    <Border Width="8"
                            Height="54"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource StudioSurface}"
                            BorderBrush="{DynamicResource StudioBorder}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                            <Border Width="2" Height="4" CornerRadius="1" Background="{DynamicResource StudioMuted}"/>
                            <Border Width="2" Height="4" CornerRadius="1" Background="{DynamicResource StudioMuted}"/>
                            <Border Width="2" Height="4" CornerRadius="1" Background="{DynamicResource StudioMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter x:Name="PaneSplitter"
                              Grid.Column="1"
                              Width="14"
                              IsVisible="{Binding IsWorkspacePaneVisible}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#01000000"
                              Cursor="SizeWestEast"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False"
                              DragIncrement="1"
                              KeyboardIncrement="16"
                              ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.PaneResizeTip}}"/>

                <Button Grid.Column="1"
                             Width="32"
                             Height="30"
                             Margin="0,18,0,0"
                             Padding="7"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Command="{Binding ToggleWorkspacePane}"
                             IsVisible="{Binding IsWorkspacePaneVisible}"
                             AutomationProperties.Name="{Binding ToggleWorkspacePaneToolTip}"
                             ToolTip.Tip="{Binding ToggleWorkspacePaneToolTip}">
                    <PathIcon Data="M3,4 L13,4 M3,8 L13,8 M3,12 L13,12 M6,6 L3,8 L6,10" Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource StudioMuted}"/>
                </Button>

                <Border x:Name="MindMapPanel"
                        Grid.Column="2"
                        Classes="panel"
                        Background="{DynamicResource StudioSurface}"
                        BorderBrush="{DynamicResource StudioBorder}"
                        Padding="10,0,10,10">
                    <Grid RowDefinitions="Auto,14,Auto,*"
                          RowSpacing="0">
                        <Grid ColumnDefinitions="Auto,*"
                              Height="30">
                            <Button Width="28"
                                         Height="24"
                                         Padding="6,4"
                                         ZIndex="1"
                                         Command="{Binding ToggleWorkspacePane}"
                                         IsVisible="{Binding IsWorkspacePaneHidden}"
                                         AutomationProperties.Name="{Binding ToggleWorkspacePaneToolTip}"
                                         ToolTip.Tip="{Binding ToggleWorkspacePaneToolTip}">
                                <PathIcon Data="M3,4 L13,4 M3,8 L13,8 M3,12 L13,12 M10,6 L13,8 L10,10" Width="12"
                                                          Height="12"
                                                          Foreground="{DynamicResource StudioMuted}"/>
                            </Button>
                            <Grid Grid.ColumnSpan="2"
                                  Width="42"
                                  RowDefinitions="*,2"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  IsHitTestVisible="False">
                                <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.MindMapTitle}}"
                                           FontSize="13"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource StudioAccent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Row="1"
                                        Width="28"
                                        Height="2"
                                        Background="{DynamicResource StudioAccent}"
                                        HorizontalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="2"
                                IsVisible="{Binding IsBlankDocument}"
                                Background="{DynamicResource StudioRaised}"
                                BorderBrush="{DynamicResource StudioBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,6"
                                Padding="10,8">
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="8">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <PathIcon Data="M8,1 A5,5 0 0 0 5,10 L5,13 L11,13 L11,10 A5,5 0 0 0 8,1 M5,15 L11,15" Width="16"
                                                       Height="16"
                                                       Foreground="{DynamicResource StudioMuted}"/>
                                    <TextBlock Text="{Binding QuickStartTitleText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource StudioText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding QuickStartDescriptionText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource StudioMuted}"
                                           TextWrapping="Wrap"/>
                                <WrapPanel Grid.Row="2"
                                           HorizontalAlignment="Left">
                                    <Button
                                                 MinHeight="30"
                                                 Margin="0,0,8,8"
                                                 Padding="10,0"
                                                 Command="{Binding CreateProductPlanTemplateAsync}"
                                                 Content="{Binding ProductPlanTemplateText}"
                                                 AutomationProperties.Name="{Binding ProductPlanTemplateText}"
                                                 ToolTip.Tip="{Binding ProductPlanTemplateDescriptionText}"/>
                                    <Button MinHeight="30"
                                                 Margin="0,0,8,8"
                                                 Padding="10,0"
                                                 Command="{Binding CreateMeetingNotesTemplateAsync}"
                                                 Content="{Binding MeetingNotesTemplateText}"
                                                 AutomationProperties.Name="{Binding MeetingNotesTemplateText}"
                                                 ToolTip.Tip="{Binding MeetingNotesTemplateDescriptionText}"/>
                                    <Button MinHeight="30"
                                                 Margin="0,0,8,8"
                                                 Padding="10,0"
                                                 Command="{Binding CreateStudyNotesTemplateAsync}"
                                                 Content="{Binding StudyNotesTemplateText}"
                                                 AutomationProperties.Name="{Binding StudyNotesTemplateText}"
                                                 ToolTip.Tip="{Binding StudyNotesTemplateDescriptionText}"/>
                                    <Button MinHeight="30"
                                                 Margin="0,0,8,8"
                                                 Padding="10,0"
                                                 Command="{Binding AddChildToSelected}"
                                                 Content="{codewf:I18n {x:Static l:ZhijianL.AddChild}}"
                                                 AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.AddChild}}"/>
                                    <Button MinHeight="30"
                                                 Margin="0,0,8,8"
                                                 Padding="10,0"
                                                 Command="{Binding OpenUserManualAsync}"
                                                 Content="{codewf:I18n {x:Static l:ZhijianL.OpenUserManual}}"
                                                 AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.OpenUserManual}}"/>
                                    <Button MinHeight="30"
                                                 Margin="0,0,8,8"
                                                 Padding="10,0"
                                                 Command="{Binding ImportDocumentAsync}"
                                                 Content="{codewf:I18n {x:Static l:ZhijianL.Import}}"
                                                 AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.Import}}"/>
                                    <Button
                                                 MinHeight="30"
                                                 Padding="8,0"
                                                 Command="{Binding ToggleEditorMode}"
                                                 Content="{codewf:I18n {x:Static l:ZhijianL.MarkdownPlaceholder}}"
                                                 AutomationProperties.Name="{Binding ToggleEditorToolTip}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <mind:MindMapEditor AccentColor="{Binding AccentColor}" x:Name="MindMap"
                                            Grid.Row="3"
                                            IsDarkTheme="{Binding IsDarkTheme}"
                                            Roots="{Binding Roots}"
                                            SelectedNode="{Binding SelectedNode, Mode=TwoWay}"
                                            Controller="{Binding}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="StatusBar"
                    Grid.Row="1"
                    Classes="statusBar"
                    Margin="16,0,16,10"
                    Padding="8,4">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10"
                      MinHeight="30">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          MinWidth="0"
                          VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNodeSummary}"
                                   Foreground="{DynamicResource StudioMuted}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Foreground="{DynamicResource StudioMuted}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="2"
                               Text="{Binding HistorySummary}"
                               Foreground="{DynamicResource StudioMuted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="3"
                                VerticalAlignment="Center">
                        <Button Width="28"
                                     Height="24"
                                     Padding="6,3"
                                     Command="{Binding Undo}"
                                     IsEnabled="{Binding CanUndo}"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.Undo}}"
                                     ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.Undo}}">
                            <PathIcon Data="M3,5 L8,5 A5,5 0 0 1 8,15 M3,2 L0,5 L3,8" Width="13" Height="13" Foreground="{DynamicResource StudioMuted}"/>
                        </Button>
                        <Button Width="28"
                                     Height="24"
                                     Padding="6,3"
                                     Command="{Binding Redo}"
                                     IsEnabled="{Binding CanRedo}"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.Redo}}"
                                     ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.Redo}}">
                            <PathIcon Data="M13,5 L8,5 A5,5 0 0 0 8,15 M13,2 L16,5 L13,8" Width="13" Height="13" Foreground="{DynamicResource StudioMuted}"/>
                        </Button>
                        <Border Width="1"
                                Height="16"
                                Margin="3,0"
                                Background="{DynamicResource StudioBorder}"/>
                        <Button x:Name="MiniMapButton"
                                     Width="28"
                                     Height="24"
                                     Padding="6,3"
                                     Click="ToggleMiniMapClicked"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.MiniMap}}"
                                     ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.MiniMap}}">
                            <PathIcon Data="M1,2 L15,2 L15,14 L1,14 Z M3,11 L7,7 L10,10 L12,8 L14,11" Width="13" Height="13" Foreground="{DynamicResource StudioMuted}"/>
                        </Button>
                        <Button Width="28"
                                     Height="24"
                                     Padding="6,3"
                                     Click="CenterRootClicked"
                                     AutomationProperties.Name="{Binding CenterRootToolTip}"
                                     ToolTip.Tip="{Binding CenterRootToolTip}">
                            <PathIcon Data="M8,0 L8,4 M8,12 L8,16 M0,8 L4,8 M12,8 L16,8 M8,3 A5,5 0 1 0 8,13 A5,5 0 1 0 8,3" Width="13" Height="13" Foreground="{DynamicResource StudioMuted}"/>
                        </Button>
                        <Border Width="1"
                                Height="16"
                                Margin="3,0"
                                Background="{DynamicResource StudioBorder}"/>
                        <Button Width="28"
                                     Height="24"
                                     Padding="6,3"
                                     Click="ZoomOutClicked"
                                     AutomationProperties.Name="{Binding ZoomOutToolTip}"
                                     ToolTip.Tip="{Binding ZoomOutToolTip}">
                            <PathIcon Data="M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M11,11 L16,16 M4,7 L10,7" Width="13" Height="13" Foreground="{DynamicResource StudioMuted}"/>
                        </Button>
                        <TextBlock Width="44"
                                   Text="{Binding ZoomText, ElementName=MindMap}"
                                   Foreground="{DynamicResource StudioMuted}"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <Button Width="28"
                                     Height="24"
                                     Padding="6,3"
                                     Click="ZoomInClicked"
                                     AutomationProperties.Name="{Binding ZoomInToolTip}"
                                     ToolTip.Tip="{Binding ZoomInToolTip}">
                            <PathIcon Data="M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M11,11 L16,16 M4,7 L10,7 M7,4 L7,10" Width="13" Height="13" Foreground="{DynamicResource StudioMuted}"/>
                        </Button>
                        <Button MinWidth="40"
                                     Height="24"
                                     Padding="7,3"
                                     Click="ResetZoomClicked"
                                     AutomationProperties.Name="{Binding ResetZoomToolTip}"
                                     ToolTip.Tip="{Binding ResetZoomToolTip}">
                            <TextBlock Text="100%"
                                       FontSize="12"
                                       Foreground="{DynamicResource StudioMuted}"/>
                        </Button>
                        <Border Width="1"
                                Height="16"
                                Margin="3,0"
                                Background="{DynamicResource StudioBorder}"/>
                        <Button Width="28"
                                     Height="24"
                                     Padding="6,3"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.MindMapShortcuts}}"
                                     ToolTip.Placement="TopEdgeAlignedRight">
                            <ToolTip.Tip>
                                <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.MindMapShortcutsTip}}"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Left"/>
                            </ToolTip.Tip>
                            <PathIcon Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M5,5 C5,2 12,2 10,7 L8,9 M8,11 L8,12" Width="13" Height="13" Foreground="{DynamicResource StudioMuted}"/>
                        </Button>
                    </StackPanel>

                    <Popup x:Name="MiniMapPopup"
                                Grid.ColumnSpan="4"
                                Placement="TopEdgeAlignedRight"
                                IsLightDismissEnabled="True">
                        <Border Width="282"
                                Padding="10"
                                Background="{DynamicResource StudioSurface}"
                                BorderBrush="{DynamicResource StudioBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                BoxShadow="0 8 28 0 #24000000">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.MiniMap}}"
                                           FontSize="12"
                                           Foreground="{DynamicResource StudioMuted}"
                                           HorizontalAlignment="Center"/>
                                <mind:MindMapMiniMap x:Name="MiniMap"
                                                     AccentColor="{Binding AccentColor}"
                                                     Grid.Row="1"
                                                     Width="260"
                                                     Height="160"
                                                     Roots="{Binding Roots}"
                                                     IsDarkTheme="{Binding IsDarkTheme}"
                                                     ViewportBounds="{Binding ViewportBounds, ElementName=MindMap}"/>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="DocumentLoadingOverlay"
                IsVisible="{Binding IsDocumentBusy}"
                Background="#66000000">
            <Border Width="320"
                    MinHeight="132"
                    Padding="24,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource StudioSurface}"
                    BorderBrush="{DynamicResource StudioBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="0 14 42 0 #3A000000">
                <StackPanel Spacing="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressBar
                                        HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DocumentBusyText}"
                               MaxWidth="260"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StudioText}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Border>

        <codewf:Guide x:Name="NewUserTour"
                   IsOpen="{Binding IsNewUserTourOpen, Mode=TwoWay}">
            <codewf:Guide.CustomActions><Button Content="{codewf:I18n {x:Static l:ZhijianL.TourSkip}}" Click="SkipGuideClick" /></codewf:Guide.CustomActions>


            <codewf:GuideStep Title="{codewf:I18n {x:Static l:ZhijianL.TourWelcomeTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourWelcomeDescription}}"/>
            <codewf:GuideStep x:Name="FileMenuTourStep"
                           Placement="Bottom"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourFilesTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourFilesDescription}}"/>
            <codewf:GuideStep x:Name="OutlineTourStep"
                           Placement="Right"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourOutlineTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourOutlineDescription}}"/>
            <codewf:GuideStep x:Name="EditorModeTourStep"
                           Placement="Right"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourToggleTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourToggleDescription}}"/>
            <codewf:GuideStep Target="{Binding ElementName=MindMapPanel}"
                           Placement="Left"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourMindMapTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourMindMapDescription}}"/>
            <codewf:GuideStep Target="{Binding ElementName=MindMap}"
                           Placement="Left"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourCanvasTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourCanvasDescription}}"/>
            <codewf:GuideStep Target="{Binding ElementName=StatusBar}"
                           Placement="Top"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourStatusTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourStatusDescription}}"/>
        </codewf:Guide>
    </Grid>
</codewf:CodeWFWindow>
