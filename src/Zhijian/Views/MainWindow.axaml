<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="using:AtomUI.Desktop.Controls"
             xmlns:icons="using:AtomUI.Icons.AntDesign"
             xmlns:mind="https://codewf.com"
             xmlns:views="using:Zhijian.Views"
             xmlns:vm="using:Zhijian.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="820"
             x:Class="Zhijian.Views.MainWindow"
             x:DataType="vm:MainWindowViewModel"
             Icon="/Assets/logo.png"
             Width="1240"
             Height="820"
             MinWidth="980"
             MinHeight="640"
             Title="枝见 Zhijian"
             TitleBarFrameBackground="{Binding TitleBarBackground}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <atom:Window.Logo>
        <Image Source="/Assets/logo.png"/>
    </atom:Window.Logo>

    <atom:Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 6 18 0 #10000000"/>
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#667085"/>
        </Style>
        <Style Selector="Border.statusBar">
            <Setter Property="Background" Value="{Binding PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{Binding PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 4 14 0 #0F000000"/>
        </Style>
    </atom:Window.Styles>

    <Grid Background="{Binding ShellBackground}">
        <Grid RowDefinitions="*,Auto">
            <Grid x:Name="PaneGrid" Grid.Row="0" Margin="16,16,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" MinWidth="320" MaxWidth="640"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="OutlinePaneHost"
                        Grid.Column="0"
                        Classes="panel"
                        Background="{Binding PanelBackground}"
                        BorderBrush="{Binding PanelBorderBrush}">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="14,12,12,10" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding EditorPaneTitle}"
                                       Classes="panelTitle"
                                       Foreground="{Binding PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                            <atom:Button Grid.Column="1"
                                         Width="34"
                                         Height="34"
                                         Padding="7"
                                         Command="{Binding ToggleEditorModeCommand}"
                                         AutomationProperties.Name="Toggle outline markdown"
                                         ToolTip.Tip="{Binding ToggleEditorToolTip}">
                                <Grid Width="18" Height="18">
                                    <icons:FileMarkdownOutlined Width="18"
                                                                Height="18"
                                                                Foreground="{Binding SecondaryTextBrush}"
                                                                IsVisible="{Binding IsOutlineMode}"/>
                                    <icons:UnorderedListOutlined Width="18"
                                                                Height="18"
                                                                Foreground="{Binding SecondaryTextBrush}"
                                                                IsVisible="{Binding IsMarkdownMode}"/>
                                </Grid>
                            </atom:Button>
                        </Grid>

                        <views:OutlineEditor Grid.Row="1"
                                             IsVisible="{Binding IsOutlineMode}"
                                             IsDarkTheme="{Binding IsDarkTheme}"
                                             Roots="{Binding Roots}"
                                             SelectedNode="{Binding SelectedNode, Mode=TwoWay}"/>

                        <atom:TextBox Grid.Row="1"
                                      IsVisible="{Binding IsMarkdownMode}"
                                      Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap"
                                      FontFamily="Consolas, Menlo, monospace"
                                      FontSize="14"
                                      Margin="14"
                                      Padding="10,8"
                                      PlaceholderText="Markdown"
                                      Foreground="{Binding PrimaryTextBrush}"
                                      Background="{Binding PanelBackground}"
                                      BorderBrush="{Binding PanelBorderBrush}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      AutomationProperties.Name="Markdown editor"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      IsHitTestVisible="False">
                    <Border Width="1"
                            HorizontalAlignment="Center"
                            Background="{Binding PanelBorderBrush}"/>
                    <Border Width="8"
                            Height="54"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{Binding PanelBackground}"
                            BorderBrush="{Binding PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                            <Border Width="2" Height="4" CornerRadius="1" Background="{Binding SecondaryTextBrush}"/>
                            <Border Width="2" Height="4" CornerRadius="1" Background="{Binding SecondaryTextBrush}"/>
                            <Border Width="2" Height="4" CornerRadius="1" Background="{Binding SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="PaneSplitter"
                        Grid.Column="1"
                        Width="14"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#01000000"
                        Cursor="SizeWestEast"
                        ToolTip.Tip="拖拽调整大纲和脑图宽度"/>

                <Border Grid.Column="2"
                        Classes="panel"
                        Background="{Binding PanelBackground}"
                        BorderBrush="{Binding PanelBorderBrush}"
                        Padding="14">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <TextBlock Text="脑图"
                                   Classes="panelTitle"
                                   Foreground="{Binding PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>

                        <mind:MindMapEditor x:Name="MindMap"
                                            Grid.Row="1"
                                            IsDarkTheme="{Binding IsDarkTheme}"
                                            Roots="{Binding Roots}"
                                            SelectedNode="{Binding SelectedNode, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Classes="statusBar"
                    Margin="16,0,16,14"
                    Padding="10,6">
                <Grid ColumnDefinitions="Auto,16,*,Auto" MinHeight="34">
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNodeSummary}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding HistorySummary}"
                               Foreground="{Binding SecondaryTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Command="{Binding UndoCommand}"
                                     ToolTip.Tip="后退一步">
                            <icons:UndoOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Command="{Binding RedoCommand}"
                                     ToolTip.Tip="前进一步">
                            <icons:RedoOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                Background="{Binding PanelBorderBrush}"/>
                        <atom:Button x:Name="MiniMapButton"
                                     Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="ToggleMiniMapClicked"
                                     ToolTip.Tip="小图">
                            <icons:PictureOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="CenterRootClicked"
                                     ToolTip.Tip="定位到中心主题  Ctrl + L">
                            <icons:AimOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                Background="{Binding PanelBorderBrush}"/>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="ZoomOutClicked"
                                     ToolTip.Tip="缩小">
                            <icons:ZoomOutOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <TextBlock Width="48"
                                   Text="{Binding ZoomText, ElementName=MindMap}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="ZoomInClicked"
                                     ToolTip.Tip="放大">
                            <icons:ZoomInOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <atom:Button MinWidth="42"
                                     Height="28"
                                     Padding="8,4"
                                     Click="ResetZoomClicked"
                                     ToolTip.Tip="重置缩放">
                            <TextBlock Text="100%"
                                       FontSize="11"
                                       Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                Background="{Binding PanelBorderBrush}"/>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Command="{Binding OpenRepositoryCommand}"
                                     ToolTip.Tip="打开 GitHub 仓库">
                            <icons:QuestionCircleOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                    </StackPanel>

                    <atom:Popup x:Name="MiniMapPopup"
                                Grid.ColumnSpan="4"
                                RequestedPlacement="TopEdgeAlignedRight"
                                IsLightDismissEnabled="True"
                                MarginToAnchor="8">
                        <Border Width="282"
                                Padding="10"
                                Background="{Binding PanelBackground}"
                                BorderBrush="{Binding PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                BoxShadow="0 8 28 0 #24000000">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <TextBlock Text="小图"
                                           FontSize="12"
                                           Foreground="{Binding SecondaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                                <mind:MindMapMiniMap x:Name="MiniMap"
                                                     Grid.Row="1"
                                                     Width="260"
                                                     Height="160"
                                                     Roots="{Binding Roots}"
                                                     IsDarkTheme="{Binding IsDarkTheme}"
                                                     ViewportBounds="{Binding ViewportBounds, ElementName=MindMap}"/>
                            </Grid>
                        </Border>
                    </atom:Popup>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</atom:Window>
