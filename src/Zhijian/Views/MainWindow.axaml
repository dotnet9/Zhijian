<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="using:AtomUI.Desktop.Controls"
             xmlns:codewf="https://codewf.com"
             xmlns:icons="using:AtomUI.Icons.AntDesign"
             xmlns:l="clr-namespace:Zhijian"
             xmlns:mind="https://codewf.com"
             xmlns:views="using:Zhijian.Views"
             xmlns:vm="using:Zhijian.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="820"
             x:Class="Zhijian.Views.MainWindow"
             WindowStartupLocation="CenterScreen"
             x:DataType="vm:MainWindowViewModel"
             Icon="/Assets/logo.ico"
             Width="1240"
             Height="820"
             MinWidth="980"
             MinHeight="640"
             Title="{Binding WindowTitle}"
             TitleBarFrameBackground="{Binding TitleBarBackground}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <atom:Window.Logo>
        <Image Source="/Assets/logo.png"/>
    </atom:Window.Logo>

    <atom:Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 6 18 0 #10000000"/>
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#667085"/>
        </Style>
        <Style Selector="Border.statusBar">
            <Setter Property="Background" Value="{Binding PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{Binding PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 4 14 0 #0F000000"/>
        </Style>
        <Style Selector="GridSplitter">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter>
        </Style>
    </atom:Window.Styles>

    <Grid Background="{Binding ShellBackground}">
        <Grid RowDefinitions="*,Auto">
            <Grid x:Name="PaneGrid" Grid.Row="0" Margin="16,16,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="280" MaxWidth="560"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="OutlinePaneHost"
                        Grid.Column="0"
                        Classes="panel"
                        Background="{Binding PanelBackground}"
                        BorderBrush="{Binding PanelBorderBrush}">
                    <atom:TabControl SelectedIndex="{Binding WorkspaceTabIndex, Mode=TwoWay}"
                                     TabAlignmentCenter="True">
                        <atom:TabItem x:Name="FilesTabItem"
                                      Header="{codewf:I18n {x:Static l:ZhijianL.FilesTab}}">
                            <Grid RowDefinitions="Auto,*"
                                  Margin="0,8,0,0">
                                <TextBlock Text="{Binding FolderSummary}"
                                           Margin="14,0,14,8"
                                           Foreground="{Binding SecondaryTextBrush}"
                                           FontSize="12"/>

                                <atom:ListBox Grid.Row="1"
                                              ItemsSource="{Binding FolderFiles}"
                                              SelectedItem="{Binding SelectedFolderFile, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Margin="0,0,0,8"
                                              AutomationProperties.Name="Folder file list">
                                    <atom:ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MindMapFileItem">
                                            <Border Padding="12,10"
                                                    MinHeight="72"
                                                    BorderBrush="{Binding $parent[Window].DataContext.PanelBorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="2">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding $parent[Window].DataContext.PrimaryTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ExtensionText}"
                                                                   FontSize="12"
                                                                   Foreground="{Binding $parent[Window].DataContext.SecondaryTextBrush}"
                                                                   VerticalAlignment="Bottom"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Preview}"
                                                               FontSize="12"
                                                               Foreground="{Binding $parent[Window].DataContext.SecondaryTextBrush}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="36"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </atom:ListBox.ItemTemplate>
                                </atom:ListBox>
                            </Grid>
                        </atom:TabItem>

                        <atom:TabItem x:Name="OutlineTabItem"
                                      Header="{codewf:I18n {x:Static l:ZhijianL.OutlineTab}}">
                            <Grid x:Name="OutlineEditorHost"
                                  RowDefinitions="*,Auto">
                                <views:OutlineEditor Grid.Row="0"
                                                     IsVisible="{Binding IsOutlineMode}"
                                                     IsDarkTheme="{Binding IsDarkTheme}"
                                                     Roots="{Binding Roots}"
                                                     SelectedNode="{Binding SelectedNode, Mode=TwoWay}"/>

                                <atom:TextBox Grid.Row="0"
                                              IsVisible="{Binding IsMarkdownMode}"
                                              Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AcceptsReturn="True"
                                              TextWrapping="Wrap"
                                              FontFamily="Consolas, Menlo, monospace"
                                              FontSize="14"
                                              Margin="12,8,12,0"
                                              Padding="10,8"
                                              PlaceholderText="{codewf:I18n {x:Static l:ZhijianL.MarkdownPlaceholder}}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              Background="{Binding PanelBackground}"
                                              BorderBrush="{Binding PanelBorderBrush}"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              AutomationProperties.Name="Markdown editor"/>
                                <Grid Grid.Row="1" Margin="10,6,10,10" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding EditorPaneTitle}"
                                               Foreground="{Binding SecondaryTextBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <atom:Button x:Name="EditorModeToggleButton"
                                                 Grid.Column="1"
                                                 Width="32"
                                                 Height="30"
                                                  Padding="7"
                                                  Command="{Binding ToggleEditorMode}"
                                                  AutomationProperties.Name="{Binding ToggleEditorToolTip}"
                                                  atom:ToolTip.Tip="{Binding ToggleEditorToolTip}">
                                        <Grid Width="16" Height="16">
                                            <icons:FileMarkdownOutlined Width="16"
                                                                        Height="16"
                                                                        Foreground="{Binding SecondaryTextBrush}"
                                                                        IsVisible="{Binding IsOutlineMode}"/>
                                            <icons:UnorderedListOutlined Width="16"
                                                                        Height="16"
                                                                        Foreground="{Binding SecondaryTextBrush}"
                                                                        IsVisible="{Binding IsMarkdownMode}"/>
                                        </Grid>
                                    </atom:Button>
                                </Grid>
                            </Grid>
                        </atom:TabItem>
                    </atom:TabControl>
                </Border>

                <Grid Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      IsHitTestVisible="False">
                    <Border Width="1"
                            HorizontalAlignment="Center"
                            Background="{Binding PanelBorderBrush}"/>
                    <Border Width="8"
                            Height="54"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{Binding PanelBackground}"
                            BorderBrush="{Binding PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                            <Border Width="2" Height="4" CornerRadius="1" Background="{Binding SecondaryTextBrush}"/>
                            <Border Width="2" Height="4" CornerRadius="1" Background="{Binding SecondaryTextBrush}"/>
                            <Border Width="2" Height="4" CornerRadius="1" Background="{Binding SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter x:Name="PaneSplitter"
                              Grid.Column="1"
                              Width="14"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#01000000"
                              Cursor="SizeWestEast"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False"
                              DragIncrement="1"
                              KeyboardIncrement="16"
                              atom:ToolTip.Tip="拖拽调整宽度"/>

                <Border x:Name="MindMapPanel"
                        Grid.Column="2"
                        Classes="panel"
                        Background="{Binding PanelBackground}"
                        BorderBrush="{Binding PanelBorderBrush}"
                        Padding="14">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.MindMapTitle}}"
                                   Classes="panelTitle"
                                   Foreground="{Binding PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>

                        <mind:MindMapEditor x:Name="MindMap"
                                            Grid.Row="1"
                                            IsDarkTheme="{Binding IsDarkTheme}"
                                            Roots="{Binding Roots}"
                                            SelectedNode="{Binding SelectedNode, Mode=TwoWay}"
                                            Controller="{Binding}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="StatusBar"
                    Grid.Row="1"
                    Classes="statusBar"
                    Margin="16,0,16,14"
                    Padding="10,6">
                <Grid ColumnDefinitions="Auto,16,*,Auto" MinHeight="34">
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNodeSummary}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding HistorySummary}"
                               Foreground="{Binding SecondaryTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Command="{Binding Undo}"
                                     IsEnabled="{Binding CanUndo}"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.Undo}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.Undo}}">
                            <icons:UndoOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Command="{Binding Redo}"
                                     IsEnabled="{Binding CanRedo}"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.Redo}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.Redo}}">
                            <icons:RedoOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                Background="{Binding PanelBorderBrush}"/>
                        <atom:Button x:Name="MiniMapButton"
                                     Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="ToggleMiniMapClicked"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.MiniMap}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.MiniMap}}">
                            <icons:PictureOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="CenterRootClicked"
                                     AutomationProperties.Name="{Binding CenterRootToolTip}"
                                     atom:ToolTip.Tip="{Binding CenterRootToolTip}">
                            <icons:AimOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                Background="{Binding PanelBorderBrush}"/>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="ZoomOutClicked"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.ZoomOut}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.ZoomOut}}">
                            <icons:ZoomOutOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <TextBlock Width="48"
                                   Text="{Binding ZoomText, ElementName=MindMap}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="ZoomInClicked"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.ZoomIn}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.ZoomIn}}">
                            <icons:ZoomInOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <atom:Button MinWidth="42"
                                     Height="28"
                                     Padding="8,4"
                                     Click="ResetZoomClicked"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.ResetZoom}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.ResetZoom}}">
                            <TextBlock Text="100%"
                                       FontSize="11"
                                       Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                Background="{Binding PanelBorderBrush}"/>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Command="{Binding ShowNewUserTour}"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.NewUserGuide}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.NewUserGuide}}">
                            <icons:QuestionCircleOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                    </StackPanel>

                    <atom:Popup x:Name="MiniMapPopup"
                                Grid.ColumnSpan="4"
                                RequestedPlacement="TopEdgeAlignedRight"
                                IsLightDismissEnabled="True"
                                MarginToAnchor="8">
                        <Border Width="282"
                                Padding="10"
                                Background="{Binding PanelBackground}"
                                BorderBrush="{Binding PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                BoxShadow="0 8 28 0 #24000000">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.MiniMap}}"
                                           FontSize="12"
                                           Foreground="{Binding SecondaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                                <mind:MindMapMiniMap x:Name="MiniMap"
                                                     Grid.Row="1"
                                                     Width="260"
                                                     Height="160"
                                                     Roots="{Binding Roots}"
                                                     IsDarkTheme="{Binding IsDarkTheme}"
                                                     ViewportBounds="{Binding ViewportBounds, ElementName=MindMap}"/>
                            </Grid>
                        </Border>
                    </atom:Popup>
                </Grid>
            </Border>
        </Grid>
        <atom:Tour x:Name="NewUserTour"
                   IsOpen="{Binding IsNewUserTourOpen, Mode=TwoWay}">
            <atom:Tour.CustomActions>
                <views:SkipTourActionButton Content="{codewf:I18n {x:Static l:ZhijianL.TourSkip}}"/>
            </atom:Tour.CustomActions>
            <atom:Tour.Indicator>
                <atom:TextTourIndicator/>
            </atom:Tour.Indicator>
            <atom:TourStep Title="{codewf:I18n {x:Static l:ZhijianL.TourWelcomeTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourWelcomeDescription}}"/>
            <atom:TourStep x:Name="FileMenuTourStep"
                           Placement="Bottom"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourFilesTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourFilesDescription}}"/>
            <atom:TourStep Target="{Binding ElementName=OutlineEditorHost}"
                           Placement="Right"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourOutlineTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourOutlineDescription}}"/>
            <atom:TourStep Target="{Binding ElementName=EditorModeToggleButton}"
                           Placement="Right"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourToggleTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourToggleDescription}}"/>
            <atom:TourStep Target="{Binding ElementName=MindMapPanel}"
                           Placement="Left"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourMindMapTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourMindMapDescription}}"/>
            <atom:TourStep Target="{Binding ElementName=MindMap}"
                           Placement="Left"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourCanvasTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourCanvasDescription}}"/>
            <atom:TourStep Target="{Binding ElementName=StatusBar}"
                           Placement="Top"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourStatusTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourStatusDescription}}"/>
        </atom:Tour>
    </Grid>
</atom:Window>
