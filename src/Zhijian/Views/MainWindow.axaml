<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="using:AtomUI.Desktop.Controls"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:codewf="https://codewf.com"
             xmlns:icons="using:AtomUI.Icons.AntDesign"
             xmlns:l="clr-namespace:Zhijian"
             xmlns:mind="https://codewf.com"
             xmlns:views="using:Zhijian.Views"
             xmlns:vm="using:Zhijian.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="820"
             x:Class="Zhijian.Views.MainWindow"
             WindowStartupLocation="CenterScreen"
             x:DataType="vm:MainWindowViewModel"
             Icon="/Assets/logo.ico"
             Width="1240"
             Height="820"
             MinWidth="980"
             MinHeight="640"
             Title="{Binding WindowTitle}"
             TitleBarFrameBackground="{Binding TitleBarBackground}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <atom:Window.Logo>
        <Image Source="/Assets/logo.png"/>
    </atom:Window.Logo>

    <atom:Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 6 18 0 #10000000"/>
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#667085"/>
        </Style>
        <Style Selector="Border.statusBar">
            <Setter Property="Background" Value="{Binding PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{Binding PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 4 14 0 #0F000000"/>
        </Style>
        <Style Selector="GridSplitter">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter>
        </Style>
    </atom:Window.Styles>

    <Grid Background="{Binding ShellBackground}">
        <Grid RowDefinitions="*,Auto">
            <Grid x:Name="PaneGrid" Grid.Row="0" Margin="16,16,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="280" MaxWidth="560"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="OutlinePaneHost"
                        Grid.Column="0"
                        Classes="panel"
                        IsVisible="{Binding IsWorkspacePaneVisible}"
                        Background="{Binding PanelBackground}"
                        BorderBrush="{Binding PanelBorderBrush}">
                    <atom:TabControl SelectedIndex="{Binding WorkspaceTabIndex, Mode=TwoWay}"
                                     TabAlignmentCenter="True">
                        <atom:TabItem x:Name="FilesTabItem"
                                       Header="{codewf:I18n {x:Static l:ZhijianL.FilesTab}}">
                            <views:WorkspaceFilesView DataContext="{Binding FilesPane}"/>
                        </atom:TabItem>

                        <atom:TabItem x:Name="OutlineTabItem"
                                       Header="{codewf:I18n {x:Static l:ZhijianL.OutlineTab}}">
                            <views:WorkspaceOutlineView x:Name="WorkspaceOutlineView"
                                                        DataContext="{Binding OutlinePane}"/>
                        </atom:TabItem>
                    </atom:TabControl>
                </Border>

                <Grid x:Name="PaneSplitterVisual"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      IsVisible="{Binding IsWorkspacePaneVisible}"
                      IsHitTestVisible="False">
                    <Border Width="1"
                            HorizontalAlignment="Center"
                            Background="{Binding PanelBorderBrush}"/>
                    <Border Width="8"
                            Height="54"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{Binding PanelBackground}"
                            BorderBrush="{Binding PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                            <Border Width="2" Height="4" CornerRadius="1" Background="{Binding SecondaryTextBrush}"/>
                            <Border Width="2" Height="4" CornerRadius="1" Background="{Binding SecondaryTextBrush}"/>
                            <Border Width="2" Height="4" CornerRadius="1" Background="{Binding SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter x:Name="PaneSplitter"
                              Grid.Column="1"
                              Width="14"
                              IsVisible="{Binding IsWorkspacePaneVisible}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#01000000"
                              Cursor="SizeWestEast"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False"
                              DragIncrement="1"
                              KeyboardIncrement="16"
                              atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.PaneResizeTip}}"/>

                <atom:Button Grid.Column="1"
                             Width="32"
                             Height="30"
                             Margin="0,18,0,0"
                             Padding="7"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Command="{Binding ToggleWorkspacePane}"
                             IsVisible="{Binding IsWorkspacePaneVisible}"
                             AutomationProperties.Name="{Binding ToggleWorkspacePaneToolTip}"
                             atom:ToolTip.Tip="{Binding ToggleWorkspacePaneToolTip}">
                    <icons:MenuFoldOutlined Width="16"
                                            Height="16"
                                            Foreground="{Binding SecondaryTextBrush}"/>
                </atom:Button>

                <Border x:Name="MindMapPanel"
                        Grid.Column="2"
                        Classes="panel"
                        Background="{Binding PanelBackground}"
                        BorderBrush="{Binding PanelBorderBrush}"
                        Padding="14">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <atom:Button Width="32"
                                         Height="30"
                                         Padding="7"
                                         Command="{Binding ToggleWorkspacePane}"
                                         IsVisible="{Binding IsWorkspacePaneHidden}"
                                         AutomationProperties.Name="{Binding ToggleWorkspacePaneToolTip}"
                                         atom:ToolTip.Tip="{Binding ToggleWorkspacePaneToolTip}">
                                <icons:MenuUnfoldOutlined Width="16"
                                                          Height="16"
                                                          Foreground="{Binding SecondaryTextBrush}"/>
                            </atom:Button>
                            <TextBlock Grid.Column="1"
                                       Text="{codewf:I18n {x:Static l:ZhijianL.MindMapTitle}}"
                                       Classes="panelTitle"
                                       Foreground="{Binding PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1"
                                IsVisible="{Binding IsBlankDocument}"
                                Background="{Binding PanelFooterBackground}"
                                BorderBrush="{Binding PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8">
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="8">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <icons:BulbOutlined Width="16"
                                                       Height="16"
                                                       Foreground="{Binding SecondaryTextBrush}"/>
                                    <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.EmptyMindMap}}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <WrapPanel Grid.Row="1"
                                           HorizontalAlignment="Left">
                                    <atom:Button ButtonType="Primary"
                                                 MinHeight="30"
                                                 Margin="0,0,8,0"
                                                 Padding="10,0"
                                                 Command="{Binding AddChildToSelected}"
                                                 Content="{codewf:I18n {x:Static l:ZhijianL.AddChild}}"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=SubnodeOutlined}"
                                                 AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.AddChild}}"/>
                                    <atom:Button MinHeight="30"
                                                 Margin="0,0,8,0"
                                                 Padding="10,0"
                                                 Command="{Binding OpenUserManualAsync}"
                                                 Content="{codewf:I18n {x:Static l:ZhijianL.OpenUserManual}}"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=ReadOutlined}"
                                                 AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.OpenUserManual}}"/>
                                    <atom:Button MinHeight="30"
                                                 Margin="0,0,8,0"
                                                 Padding="10,0"
                                                 Command="{Binding ImportDocumentAsync}"
                                                 Content="{codewf:I18n {x:Static l:ZhijianL.Import}}"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=ImportOutlined}"
                                                 AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.Import}}"/>
                                    <atom:Button ButtonType="Text"
                                                 MinHeight="30"
                                                 Padding="8,0"
                                                 Command="{Binding ToggleEditorMode}"
                                                 Content="{codewf:I18n {x:Static l:ZhijianL.MarkdownPlaceholder}}"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=FileMarkdownOutlined}"
                                                 AutomationProperties.Name="{Binding ToggleEditorToolTip}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <mind:MindMapEditor x:Name="MindMap"
                                            Grid.Row="2"
                                            IsDarkTheme="{Binding IsDarkTheme}"
                                            Roots="{Binding Roots}"
                                            SelectedNode="{Binding SelectedNode, Mode=TwoWay}"
                                            Controller="{Binding}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="StatusBar"
                    Grid.Row="1"
                    Classes="statusBar"
                    Margin="16,0,16,14"
                    Padding="10,6">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12"
                      MinHeight="34">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12"
                          MinWidth="0"
                          VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNodeSummary}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="2"
                               Text="{Binding HistorySummary}"
                               Foreground="{Binding SecondaryTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Command="{Binding Undo}"
                                     IsEnabled="{Binding CanUndo}"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.Undo}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.Undo}}">
                            <icons:UndoOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Command="{Binding Redo}"
                                     IsEnabled="{Binding CanRedo}"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.Redo}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.Redo}}">
                            <icons:RedoOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                Background="{Binding PanelBorderBrush}"/>
                        <atom:Button x:Name="MiniMapButton"
                                     Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="ToggleMiniMapClicked"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.MiniMap}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.MiniMap}}">
                            <icons:PictureOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="CenterRootClicked"
                                     AutomationProperties.Name="{Binding CenterRootToolTip}"
                                     atom:ToolTip.Tip="{Binding CenterRootToolTip}">
                            <icons:AimOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                Background="{Binding PanelBorderBrush}"/>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="ZoomOutClicked"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.ZoomOut}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.ZoomOut}}">
                            <icons:ZoomOutOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <TextBlock Width="48"
                                   Text="{Binding ZoomText, ElementName=MindMap}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     Click="ZoomInClicked"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.ZoomIn}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.ZoomIn}}">
                            <icons:ZoomInOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <atom:Button MinWidth="42"
                                     Height="28"
                                     Padding="8,4"
                                     Click="ResetZoomClicked"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.ResetZoom}}"
                                     atom:ToolTip.Tip="{codewf:I18n {x:Static l:ZhijianL.ResetZoom}}">
                            <TextBlock Text="100%"
                                       FontSize="11"
                                       Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                        <Border Width="1"
                                Height="18"
                                Margin="4,0"
                                Background="{Binding PanelBorderBrush}"/>
                        <atom:Button Width="32"
                                     Height="28"
                                     Padding="7,4"
                                     AutomationProperties.Name="{codewf:I18n {x:Static l:ZhijianL.MindMapShortcuts}}"
                                     atom:ToolTip.Placement="TopEdgeAlignedRight">
                            <atom:ToolTip.Tip>
                                <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.MindMapShortcutsTip}}"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Left"/>
                            </atom:ToolTip.Tip>
                            <icons:QuestionCircleOutlined Width="14" Height="14" Foreground="{Binding SecondaryTextBrush}"/>
                        </atom:Button>
                    </StackPanel>

                    <atom:Popup x:Name="MiniMapPopup"
                                Grid.ColumnSpan="4"
                                RequestedPlacement="TopEdgeAlignedRight"
                                IsLightDismissEnabled="True"
                                MarginToAnchor="8">
                        <Border Width="282"
                                Padding="10"
                                Background="{Binding PanelBackground}"
                                BorderBrush="{Binding PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                BoxShadow="0 8 28 0 #24000000">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.MiniMap}}"
                                           FontSize="12"
                                           Foreground="{Binding SecondaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                                <mind:MindMapMiniMap x:Name="MiniMap"
                                                     Grid.Row="1"
                                                     Width="260"
                                                     Height="160"
                                                     Roots="{Binding Roots}"
                                                     IsDarkTheme="{Binding IsDarkTheme}"
                                                     ViewportBounds="{Binding ViewportBounds, ElementName=MindMap}"/>
                            </Grid>
                        </Border>
                    </atom:Popup>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="DocumentLoadingOverlay"
                IsVisible="{Binding IsDocumentBusy}"
                Background="#66000000">
            <Border Width="320"
                    MinHeight="132"
                    Padding="24,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{Binding PanelBackground}"
                    BorderBrush="{Binding PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="0 14 42 0 #3A000000">
                <StackPanel Spacing="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <atom:SpinIndicator SizeType="Large"
                                        HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DocumentBusyText}"
                               MaxWidth="260"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{Binding PrimaryTextBrush}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Border>

        <atom:Tour x:Name="NewUserTour"
                   IsOpen="{Binding IsNewUserTourOpen, Mode=TwoWay}">
            <atom:Tour.CustomActions>
                <views:SkipTourActionButton Content="{codewf:I18n {x:Static l:ZhijianL.TourSkip}}"/>
            </atom:Tour.CustomActions>
            <atom:Tour.Indicator>
                <atom:TextTourIndicator/>
            </atom:Tour.Indicator>
            <atom:TourStep Title="{codewf:I18n {x:Static l:ZhijianL.TourWelcomeTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourWelcomeDescription}}"/>
            <atom:TourStep x:Name="FileMenuTourStep"
                           Placement="Bottom"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourFilesTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourFilesDescription}}"/>
            <atom:TourStep x:Name="OutlineTourStep"
                           Placement="Right"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourOutlineTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourOutlineDescription}}"/>
            <atom:TourStep x:Name="EditorModeTourStep"
                           Placement="Right"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourToggleTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourToggleDescription}}"/>
            <atom:TourStep Target="{Binding ElementName=MindMapPanel}"
                           Placement="Left"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourMindMapTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourMindMapDescription}}"/>
            <atom:TourStep Target="{Binding ElementName=MindMap}"
                           Placement="Left"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourCanvasTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourCanvasDescription}}"/>
            <atom:TourStep Target="{Binding ElementName=StatusBar}"
                           Placement="Top"
                           Title="{codewf:I18n {x:Static l:ZhijianL.TourStatusTitle}}"
                           Description="{codewf:I18n {x:Static l:ZhijianL.TourStatusDescription}}"/>
        </atom:Tour>
    </Grid>
</atom:Window>
