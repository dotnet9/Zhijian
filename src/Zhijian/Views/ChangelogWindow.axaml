<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="using:AtomUI.Desktop.Controls"
             xmlns:markdown="using:CodeWF.Markdown.Lite.Controls"
             xmlns:markdownThemes="using:CodeWF.Markdown.Lite.Themes"
             xmlns:vm="using:Zhijian.ViewModels"
             x:Class="Zhijian.Views.ChangelogWindow"
             x:DataType="vm:ChangelogWindowViewModel"
             Title="更新日志"
             Width="840"
             Height="680"
             MinWidth="640"
             MinHeight="520">

    <Design.DataContext>
        <vm:ChangelogWindowViewModel/>
    </Design.DataContext>

    <Border Padding="24,20">
        <Grid RowDefinitions="Auto,*" RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="更新日志"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                    <atom:Button Content="中文"
                                 MinWidth="74"
                                 Height="30"
                                 Padding="10,4"
                                 Command="{Binding LoadChineseCommand}"/>
                    <atom:Button Content="English"
                                 MinWidth="74"
                                 Height="30"
                                 Padding="10,4"
                                 Command="{Binding LoadEnglishCommand}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <markdown:MarkdownViewer Markdown="{Binding Markdown}"
                                         TypographyTheme="{x:Static markdownThemes:MarkdownTypographyThemes.Simple}"
                                         TypographySize="{x:Static markdownThemes:MarkdownTypographySizes.Normal}"/>
            </ScrollViewer>
        </Grid>
    </Border>
</atom:Window>
