<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:codewf="https://codewf.com"
             xmlns:vm="using:Zhijian.ViewModels"
             xmlns:l="clr-namespace:Zhijian"
             x:Class="Zhijian.Views.SaveChangesWindow"
             x:DataType="vm:SaveChangesWindowViewModel"
             WindowStartupLocation="CenterOwner"
             Title="{codewf:I18n {x:Static l:ZhijianL.SaveChanges}}"
             Width="420"
             Height="190"
             MinWidth="420"
             MinHeight="190"
             CanResize="False">

    <Design.DataContext>
        <vm:SaveChangesWindowViewModel/>
    </Design.DataContext>

    <Border Padding="22,20">
        <Grid RowDefinitions="*,Auto">
            <StackPanel Spacing="8">
                <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.SaveChanges}}"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource StudioMuted}"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button MinWidth="76"
                             Content="{codewf:I18n {x:Static l:ZhijianL.Cancel}}"
                             Click="CancelClicked"/>
                <Button MinWidth="76"
                             Content="{codewf:I18n {x:Static l:ZhijianL.DiscardChanges}}"
                             Click="DiscardClicked"/>
                <Button MinWidth="76"
                             Content="{codewf:I18n {x:Static l:ZhijianL.Save}}"
                             Click="SaveClicked"/>
            </StackPanel>
        </Grid>
    </Border>
</codewf:CodeWFWindow>
