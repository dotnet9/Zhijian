<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:l="clr-namespace:Zhijian"
             xmlns:vm="using:Zhijian.ViewModels"
             x:Class="Zhijian.Views.AboutWindow"
             x:DataType="vm:AboutWindowViewModel"
             WindowStartupLocation="CenterOwner"
             Title="{codewf:I18n {x:Static l:ZhijianL.AboutWindowTitle}}"
             Width="700"
             Height="640"
             MinWidth="560"
             MinHeight="460"
             Background="{DynamicResource StudioBackground}"
             Foreground="{DynamicResource StudioText}"
             TitleBarHeight="40" CaptionButtonWidth="34">

    <Design.DataContext>
        <vm:AboutWindowViewModel/>
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Border Padding="28,24">
        <StackPanel Spacing="0">
            <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.AppName}}"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.AboutDescription}}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StudioMuted}"/>

            <Grid Margin="0,18,0,0"
                  ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="10">
                <TextBlock Grid.Row="0"
                           Text="{codewf:I18n {x:Static l:ZhijianL.AboutVersion}}"
                           Classes="aboutLabel"/>
                <SelectableTextBlock Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding Version}"
                                     Classes="aboutValue"/>

                <TextBlock Grid.Row="1"
                           Text="{codewf:I18n {x:Static l:ZhijianL.AboutCompileTime}}"
                           Classes="aboutLabel"/>
                <SelectableTextBlock Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding CompileTime}"
                                     Classes="aboutValue"/>

                <TextBlock Grid.Row="2"
                           Text="{codewf:I18n {x:Static l:ZhijianL.AboutAuthor}}"
                           Classes="aboutLabel"/>
                <SelectableTextBlock Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding Author}"
                                     Classes="aboutValue"/>

                <TextBlock Grid.Row="3"
                           Text="{codewf:I18n {x:Static l:ZhijianL.AboutContact}}"
                           Classes="aboutLabel"/>
                <Button Grid.Row="3"
                                      Grid.Column="1"
                                      Click="OpenLinkClick" Tag="{Binding ContactUri}"
                                      Padding="0"
                                      HorizontalAlignment="Left"
                                      HorizontalContentAlignment="Left"
                                      VerticalAlignment="Center">
                    <TextBlock Text="{Binding ContactUrl}" TextWrapping="Wrap"/>
                </Button>

                <TextBlock Grid.Row="4"
                           Text="{codewf:I18n {x:Static l:ZhijianL.AboutRepository}}"
                           Classes="aboutLabel"/>
                <Button Grid.Row="4"
                                      Grid.Column="1"
                                      Click="OpenLinkClick" Tag="{Binding RepositoryUri}"
                                      Padding="0"
                                      HorizontalAlignment="Left"
                                      HorizontalContentAlignment="Left"
                                      VerticalAlignment="Center">
                    <TextBlock Text="{Binding RepositoryUrl}" TextWrapping="Wrap"/>
                </Button>

                <TextBlock Grid.Row="5"
                           Text="{codewf:I18n {x:Static l:ZhijianL.AboutMindViewPackage}}"
                           Classes="aboutLabel"/>
                <Button Grid.Row="5"
                                      Grid.Column="1"
                                      Click="OpenLinkClick" Tag="{Binding MindViewNuGetUri}"
                                      Padding="0"
                                      HorizontalAlignment="Left"
                                      HorizontalContentAlignment="Left"
                                      VerticalAlignment="Center">
                    <TextBlock Text="{Binding MindViewNuGetUrl}" TextWrapping="Wrap"/>
                </Button>
                <TextBlock Grid.Row="6" Text="{codewf:I18n {x:Static l:ZhijianL.AboutPlatform}}" Classes="aboutLabel" />
                <SelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Platform}" Classes="aboutValue" />
                <TextBlock Grid.Row="7" Text="{codewf:I18n {x:Static l:ZhijianL.AboutCopyright}}" Classes="aboutLabel" />
                <SelectableTextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Copyright}" Classes="aboutValue" />
            </Grid>

            <Border Margin="0,20,0,0"
                    Padding="14,12"
                    CornerRadius="8"
                    Background="{DynamicResource StudioSurface}"
                    DataContext="{Binding Update}">
                <StackPanel Spacing="8" x:DataType="vm:UpdateViewModel">
                    <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.UpdateCheck}}" FontWeight="SemiBold" />
                    <TextBlock Text="{codewf:I18n {x:Static l:ZhijianL.AboutUpdateDescription}}" TextWrapping="Wrap" Foreground="{DynamicResource StudioMuted}" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Margin="0,0,8,4" Command="{Binding UpdateCommand}" Content="{Binding ActionText}" IsEnabled="{Binding !IsBusy}" />
                        <Button Margin="0,0,8,4" Command="{Binding CheckCommand}" Content="{codewf:I18n {x:Static l:ZhijianL.AboutRecheck}}" IsVisible="{Binding CanRecheck}" />
                        <Button Margin="0,0,8,4" Command="{Binding CancelCommand}" Content="{codewf:I18n {x:Static l:ZhijianL.AboutCancel}}" IsVisible="{Binding IsBusy}" />
                    </WrapPanel>
                    <ProgressBar Height="6" IsVisible="{Binding IsDownloading}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Value="{Binding Progress}" />
                    <TextBlock FontSize="12" Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource StudioMuted}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
    </ScrollViewer>

    <codewf:CodeWFWindow.Styles>
        <Style Selector="TextBlock.aboutLabel">
            <Setter Property="Foreground" Value="{DynamicResource StudioMuted}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="SelectableTextBlock.aboutValue">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </codewf:CodeWFWindow.Styles>
</codewf:CodeWFWindow>
