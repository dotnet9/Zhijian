<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Title>CodeWF.MindView</Title>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
		<Description>Avalonia mind-map controls and document import/export contracts for CodeWF applications.</Description>
		<PackageId>CodeWF.MindView</PackageId>
		<AssemblyName>CodeWF.MindView</AssemblyName>
		<RootNamespace>CodeWF.MindView</RootNamespace>
		<PackageIcon>logo.png</PackageIcon>
		<PackageTags>avalonia ui,mindmap,mind-view,controls,codewf</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md" Visible="false" />
		<None Include="..\..\logo.png" Pack="true" PackagePath="" Link="logo.png" Visible="false" />
	</ItemGroup>
</Project>
