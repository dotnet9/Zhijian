<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="using:AtomUI.Desktop.Controls"
             xmlns:icons="using:AtomUI.Icons.AntDesign"
             xmlns:views="using:Zhijian.Desktop.Views"
             xmlns:vm="using:Zhijian.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="820"
             x:Class="Zhijian.Desktop.Views.MainWindow"
             x:DataType="vm:MainWindowViewModel"
             Icon="/Assets/logo.png"
             Width="1240"
             Height="820"
             MinWidth="980"
             MinHeight="640"
             IsMoveEnabled="False"
             Title="枝见 Zhijian"
             TitleBarFrameBackground="{Binding TitleBarBackground}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <atom:Window.Logo>
        <Image Source="/Assets/logo.png"/>
    </atom:Window.Logo>

    <atom:Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 6 18 0 #10000000"/>
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#667085"/>
        </Style>
    </atom:Window.Styles>

    <Grid Background="{Binding ShellBackground}">
        <Grid Margin="16" ColumnDefinitions="440,10,*">
            <Border Grid.Column="0"
                    Classes="panel"
                    Background="{Binding PanelBackground}"
                    BorderBrush="{Binding PanelBorderBrush}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" Margin="14,12,12,10" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding EditorPaneTitle}"
                                   Classes="panelTitle"
                                   Foreground="{Binding PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <atom:Button Grid.Column="1"
                                     Width="34"
                                     Height="34"
                                     Padding="7"
                                     Command="{Binding ToggleEditorModeCommand}"
                                     AutomationProperties.Name="Toggle outline markdown"
                                     ToolTip.Tip="{Binding ToggleEditorToolTip}">
                            <Grid Width="18" Height="18">
                                <icons:FileMarkdownOutlined Width="18"
                                                            Height="18"
                                                            Foreground="#223042"
                                                            IsVisible="{Binding IsOutlineMode}"/>
                                <icons:UnorderedListOutlined Width="18"
                                                            Height="18"
                                                            Foreground="#223042"
                                                            IsVisible="{Binding IsMarkdownMode}"/>
                            </Grid>
                        </atom:Button>
                    </Grid>

                    <views:OutlineEditor Grid.Row="1"
                                         IsVisible="{Binding IsOutlineMode}"
                                         IsDarkTheme="{Binding IsDarkTheme}"
                                         Roots="{Binding Roots}"
                                         SelectedNode="{Binding SelectedNode, Mode=TwoWay}"/>

                    <atom:TextBox Grid.Row="1"
                                  IsVisible="{Binding IsMarkdownMode}"
                                  Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AcceptsReturn="True"
                                  TextWrapping="Wrap"
                                  FontFamily="Consolas, Menlo, monospace"
                                  FontSize="14"
                                  Margin="14"
                                  Padding="10,8"
                                  PlaceholderText="Markdown"
                                  Foreground="{Binding PrimaryTextBrush}"
                                  Background="{Binding PanelBackground}"
                                  BorderBrush="{Binding PanelBorderBrush}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Markdown editor"/>

                    <Border Grid.Row="2"
                            Background="{Binding PanelFooterBackground}"
                            BorderBrush="{Binding PanelBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding SecondaryTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedNodeSummary}"
                                       Foreground="{Binding SecondaryTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          Background="#D7DEE8"
                          ResizeDirection="Columns"
                          ShowsPreview="True"/>

            <Border Grid.Column="2"
                    Classes="panel"
                    Background="{Binding PanelBackground}"
                    BorderBrush="{Binding PanelBorderBrush}"
                    Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="脑图"
                                   Classes="panelTitle"
                                   Foreground="{Binding PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedNodeSummary}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <views:MindMapEditor Grid.Row="1"
                                         IsDarkTheme="{Binding IsDarkTheme}"
                                         Roots="{Binding Roots}"
                                         SelectedNode="{Binding SelectedNode, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</atom:Window>
